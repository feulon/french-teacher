# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# Usuário do único login. Obrigatório: sem ele o app não sobe.
APP_USERNAME=

# Senha do único usuário (mínimo de 12 caracteres). Obrigatória: sem ela o app não sobe.
# Gere uma senha longa com: openssl rand -base64 18
# Se a senha tiver o caractere $, escreva entre aspas simples: APP_PASSWORD='abc$def123'
APP_PASSWORD=

# Fuso horário usado para "hoje" e para os dias da semana.
TZ=America/Sao_Paulo

# Cookie de sessão com a flag Secure: auto (padrão, ativa quando o acesso é por HTTPS, como no
# Cloudflare Tunnel), true ou false.
COOKIE_SECURE=auto

# Porta e endereço publicados no servidor (só docker compose).
HOST_PORT=3000
BIND_ADDRESS=127.0.0.1
